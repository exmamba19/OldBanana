# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# OpenGraph images, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show dashed boxes where ads will appear while keys are still empty.
# Set to "false" in production so unused slots collapse to nothing.
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=true

# ---------------------------------------------------------------------------
# Adsterra — copy the values out of the code snippets in your Adsterra
# dashboard (Websites -> Get code). See README.md "Adsterra setup".
# Leave a value empty to disable that slot.
# ---------------------------------------------------------------------------

# 1. Popunder: the src of <script src="//plXXXX.example.com/aa/bb/cc/aabbcc.js">
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=

# 2. Social Bar: the src of its <script> tag
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_SRC=

# 3-5. Banners: the 'key' from atOptions = { 'key' : '...' } of each banner
NEXT_PUBLIC_ADSTERRA_BANNER_728X90_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_320X50_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_300X250_KEY=
# Host of the banner invoke.js script (the part between // and /KEY/invoke.js)
NEXT_PUBLIC_ADSTERRA_BANNER_HOST=www.highperformanceformat.com

# 4. Native Banner: the src of <script async src="//plXXXX.example.com/KEY/invoke.js">
#    and the id of the <div id="container-KEY"> that comes with it
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=
NEXT_PUBLIC_ADSTERRA_NATIVE_CONTAINER_ID=

# 6. Direct Links (full https URLs). Album falls back to the download link.
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK_DOWNLOAD=
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK_ALBUM=
# Minutes before the same Direct Link opens again for one visitor (0 = every click)
NEXT_PUBLIC_DIRECT_LINK_COOLDOWN_MINUTES=10
